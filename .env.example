# Copy to .env (never commit it) or export these in your shell.
# PostgreSQL connection: either a URL...
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE
# ...or the standard libpq variables.
# PGHOST=localhost
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=

# Where `cnpj` keeps the monthly archives (default: ./data)
# CNPJ_DATA_DIR=./data

# Only for the PostgreSQL integration tests: a DISPOSABLE database.
# CNPJ_TEST_DSN=postgresql://postgres:test@127.0.0.1:5432/cnpj_test
